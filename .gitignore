# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Secrets. The backend keeps its own copy of these rules in server/.gitignore;
# this pair is here so a stray .env at the repo root is ignored too. Only the
# .example templates are tracked.
.env
.env.*
!.env.example

# Local machine settings, not project configuration.
.claude/settings.local.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
plans
.*/
deploy/deployment.yaml

# Strict-audit scratch space: generated YAML, mihomo logs, temp certs (P2+).
# Never committed; safe to delete and re-generate.
audit-tmp/
docs/
