# Copy to .env and fill in. .env is gitignored; this file is not.

# ---- Database ----
POSTGRESQL_DSN=postgres://mihomo:mihomo@localhost:5432/mihomo?sslmode=disable

# ---- Auth ----
# 32+ bytes, or the server refuses to start. Generate with:
#   openssl rand -base64 48
JWT_SECRET=
JWT_TTL=168h

# GitHub OAuth App: https://github.com/settings/developers
# The app's "Authorization callback URL" must match the frontend's
# VITE_OAUTH_REDIRECT_URI, which defaults to the frontend's own origin —
# http://localhost:3000/ for the Vite dev server.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Server ----
PORT=8080
APP_ENV=development

# Origin used to build the subscription URLs handed to Mihomo clients. It must
# be reachable by those clients, so localhost only works while testing on the
# same machine.
PUBLIC_BASE_URL=http://localhost:8080

# Comma-separated. The Vite dev server runs on :3000 (see vite.config.ts).
CORS_ORIGINS=http://localhost:3000

# Proxy addresses whose X-Forwarded-For may be believed, comma-separated, as
# CIDRs or bare IPs. Empty means trust none, which is right when the server is
# reached directly.
#
# Set this when something sits in front — nginx, Caddy, Cloudflare, a load
# balancer. The rate limiters bucket by client address, so unset behind a proxy
# means every request looks like it came from the proxy and the whole internet
# shares one bucket; set too widely, a caller picks its own bucket by sending a
# header. Neither failure is visible until someone is refused.
# TRUSTED_PROXIES=172.18.0.0/16

# ---- Subscription import ----
# Bounds on POST /api/v1/import/fetch, which fetches a third-party subscription
# on a signed-in user's behalf — the escape hatch for providers that send no
# CORS headers and so cannot be read by the browser directly.
#
# Addresses inside this server's own network are always refused, and that is not
# configurable: the endpoint exists to reach subscription providers, and a fetch
# aimed at localhost or a private range is either a mistake or a probe.
# IMPORT_FETCH_TIMEOUT=15s
# IMPORT_FETCH_MAX_BYTES=2097152

# Sent as the outbound User-Agent. Many providers answer the same URL with
# different formats depending on it — YAML for a Clash client, a base64 URI list
# for anything else — so this decides which one the server is offered.
# IMPORT_FETCH_UA=clash.meta/1.19.0

# ---- Logging ----
# debug | info | warn | error. Defaults to debug in development, info in
# production.
#
# debug prints every SQL statement, and the values in them are config documents
# — which contain proxy passwords — so it is a deliberate choice in production
# rather than a convenience. The three statements carrying a subscription token
# are silenced at every level.
# LOG_LEVEL=debug

# json | text. Defaults to text in development, json in production.
# LOG_FORMAT=text

# ---- Mihomo runtime (optional) -------------------------------------------
# POST /api/v1/mihomo/validate runs the real binary over a submitted config.
# Both settings are optional: with no binary reachable the endpoints answer
# 503 and the frontend falls back to local validation only.

# Path to the mihomo binary. A bare name resolves on PATH; in Docker, build
# the image with --build-arg MIHOMO_VERSION=v1.19.x to bake one in at
# /usr/local/bin/mihomo.
# MIHOMO_BINARY_PATH=mihomo

# Per-run subprocess budget. Must stay under the HTTP server WriteTimeout
# (60s); boot fails loudly if not.
# MIHOMO_VALIDATE_TIMEOUT=10s
